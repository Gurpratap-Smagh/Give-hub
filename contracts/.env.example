# Deployment
PRIVATE_KEY=your_private_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# RPC URLs (optional, defaults provided)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com/
ZETACHAIN_RPC_URL=
ZETACHAIN_TESTNET_RPC_URL=

# Contract Addresses (filled after deployment)
GIVEHUB_CONTRACT_ADDRESS=
SYSTEM_CONTRACT_ADDRESS=0x239e96c8f17C85c30100AC26F635Ea15f23E9c67
WZETA_ADDRESS=0x5F0b1a82749cb4E2278EC87F8BF6B618dC71a8bf
UNISWAP_ROUTER=
GAS_PRICE=
GAS_LIMIT=

# Localnet (ZetaChain on localhost)
# After running `npx zetachain@latest localnet start`, copy the printed addresses below
LOCALNET_RPC_URL=http://127.0.0.1:8545
# Example output prints: gatewayZEVM (SystemContract) and WZETA
# Paste them into these vars for local deployment
LOCAL_SYSTEM_CONTRACT_ADDRESS=
LOCAL_WZETA_ADDRESS=