# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gemini AI Configuration (Required)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Database Configuration
# Set to true to use MongoDB, false to use JSON mock database
USE_MONGODB=false
MONGODB_URI=mongodb://localhost:27017/givehub
MONGODB_DB=Give-hub

# Layout Configuration
NEXT_PUBLIC_layout=false

# Gemini AI Prompts (Advanced Configuration)
GEMINI_PLANNER_PROMPT=You are a routing planner for GiveHub. Think silently, then emit ONE action as strict JSON that matches this schema: type Plan = | { "type": "search_campaigns", "query": { "q": string, "limit"?: number, "category"?: string, "title"?: string, "titleOnly"?: boolean } } | { "type": "open_payment", "campaignId": string, "amount"?: number, "chain"?: string } | { "type": "final", "text": string }

GEMINI_EDIT_SYSTEM_PROMPT=You are a precise editor. Apply the instruction strictly and return only the edited text.

GEMINI_EXECUTOR_PROMPT=You are a concise presenter for GiveHub. Never say "user said..."; speak directly to the user in first person. If "search_campaigns" results are provided, show up to 10 in a neat list or markdown table with: title, category, goal, raised, id. Keep it skimmable. Mention if no results were found.

GEMINI_SYSTEM_PROMPT=You are Give-Hub assistant. Be concise, positive, and safe.

GEMINI_PAY_SYSTEM_PROMPT=You are Give-Hub's payment assistant. Extract title, chain/currency, and amount from user input. If ambiguous, ask concise clarifying questions. When confident, output ONLY action JSON: {"type":"open_payment","title":"...","chain":"Ethereum|Solana|Bitcoin","amount":number}. Keep text concise and safe.

# Blockchain Configuration (Optional - for on-chain functionality)
NEXT_PUBLIC_WZETA_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXT_PUBLIC_PAYMENT_PROVIDER=zetachain
NEXT_PUBLIC_GIVEHUB_CONTRACT_ADDRESS=0xCA8c8688914e0F7096c920146cd0Ad85cD7Ae8b9
NEXT_PUBLIC_ZETA_CHAIN_ID=31337
NEXT_PUBLIC_ZETA_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_ZETA_CHAIN_NAME=ZetaChain Local
NEXT_PUBLIC_ZETA_NATIVE_SYMBOL=ZETA
NEXT_PUBLIC_ZETA_EXPLORER_URL=

# Backend-only Blockchain Configuration (for indexer/sync)
ZETA_RPC_URL=http://127.0.0.1:8545
GIVEHUB_CONTRACT_ADDRESS=0xCA8c8688914e0F7096c920146cd0Ad85cD7Ae8b9
GIVEHUB_START_BLOCK=0

# AI Image Generation (Optional)
USE_IMAGEN=false
IMAGEN_MODEL=imagen-4.0-generate-preview-06-06

# Multiple Gemini API Keys (Optional - comma separated for load balancing)
GEMINI_KEYS=
