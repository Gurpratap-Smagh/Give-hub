# GiveHub Environment Configuration
# Copy this file to .env.local for development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters-long
JWT_EXPIRES_IN=24h

# MongoDB Configuration (for future integration)
# MONGODB_URI=mongodb://localhost:27017/givehub
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/givehub

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ZetaChain / On-chain Payments
# Set provider to 'zetachain' to enable on-chain donations via MetaMask
NEXT_PUBLIC_PAYMENT_PROVIDER=local
# Contract address of deployed CrossChainCrowdfund
NEXT_PUBLIC_GIVEHUB_CONTRACT_ADDRESS=
# WZETA (wrapped Zeta) token address on the current network
NEXT_PUBLIC_WZETA_ADDRESS=
# ZetaChain network parameters
NEXT_PUBLIC_ZETA_CHAIN_ID=7001
NEXT_PUBLIC_ZETA_RPC_URL=
# Optional: Explorer base URL to construct receipt links (e.g., https://zetachain-athens-3.blockscout.com)
NEXT_PUBLIC_ZETA_EXPLORER_URL=

# Local DEX (Uniswap v2) Swap Configuration
# Router address for swaps (printed by contracts/scripts/deploy-dex.js)
NEXT_PUBLIC_UNISWAP_ROUTER=
# Test token addresses (printed by deploy-dex.js)
NEXT_PUBLIC_ETHZ_ADDRESS=
NEXT_PUBLIC_BTCZ_ADDRESS=

# Rate Limiting (for future implementation)
# REDIS_URL=redis://localhost:6379

# Email Configuration (for future email verification)
# EMAIL_FROM=noreply@givehub.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Web3 Configuration (for future smart contract integration)
# ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your-project-id
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# BITCOIN_RPC_URL=https://bitcoin-rpc-url

# AI Prompts
# When true, use built-in defaults and ignore GEMINI_* prompt overrides
default-prompt=false
# Gemini API Key (server only)
# GEMINI_API_KEY=your-gemini-api-key
# Optional: system prompts (only used when default-prompt=false)
# GEMINI_PLANNER_PROMPT=...
# GEMINI_EXECUTOR_PROMPT=...
# GEMINI_EDIT_SYSTEM_PROMPT=...
# GEMINI_PAY_SYSTEM_PROMPT=...
# New default-prompt toggle and Gemini prompt env overrides
# default-prompt: When true, use built-in defaults and ignore GEMINI_* prompt overrides
# GEMINI_PLANNER_PROMPT: Optional prompt override for planner system
# GEMINI_EXECUTOR_PROMPT: Optional prompt override for executor system
# GEMINI_EDIT_SYSTEM_PROMPT: Optional prompt override for edit system
# GEMINI_PAY_SYSTEM_PROMPT: Optional prompt override for pay system
# Security Configuration
# ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
