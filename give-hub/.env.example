# JWT Authentication (server) - REQUIRED
JWT_SECRET=""
JWT_EXPIRES_IN=24h
# Bcrypt salt rounds for password hashing
BCRYPT_SALT_ROUNDS=12
# Gemini
# Required for AI features
GEMINI_API_KEY=

## Database (optional)
# Set true to use MongoDB; false uses JSON mock DB
USE_MONGODB=false
MONGODB_URI=""
MONGODB_DB=Give-hub

## On-chain (frontend)
# Set to 'zetachain' to enable on-chain features, 'mock' for development
NEXT_PUBLIC_PAYMENT_PROVIDER=mock
# Primary (preferred) public contract address
NEXT_PUBLIC_CROSSCHAIN_CONTRACT=
# Supported legacy aliases (also read by code):
NEXT_PUBLIC_GIVEHUB_CONTRACT_ADDRESS=
NEXT_PUBLIC_CROWDFUND_ADDRESS=
# Chain and core addresses
NEXT_PUBLIC_ZETA_CHAIN_ID=7001
NEXT_PUBLIC_WZETA_ADDRESS=
NEXT_PUBLIC_SYSTEM_CONTRACT_ADDRESS=
# Public RPC used by web3/client read-only provider and wallet_addEthereumChain
NEXT_PUBLIC_ZETA_RPC_URL=
# Optional display values
NEXT_PUBLIC_ZETA_CHAIN_NAME=
NEXT_PUBLIC_ZETA_NATIVE_SYMBOL=ZETA
NEXT_PUBLIC_ZETA_EXPLORER_URL=
# Supported legacy aliases (do not set unless needed for older builds)
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_WZETA=

## Cross-chain (Ethereum Sepolia → ZetaChain)
# Gateway contract on Sepolia and receiver on ZEVM
NEXT_PUBLIC_GATEWAY_SEPOLIA=
NEXT_PUBLIC_ERC20_SEPOLIA_USDC=
# zETH marker (used for native path detection in UI)
NEXT_PUBLIC_ZRC20_ZETH_SEPOLIA=
# HTTP RPC for ZEVM used by cross-chain helpers (can be same as NEXT_PUBLIC_ZETA_RPC_URL)
NEXT_PUBLIC_ZETA_RPC_HTTP=

## Token list for UI (server-only)
# Comma-separated: SYMBOL.CHAIN=0xAddress
# Example: USDC.SEPOLIA=0x.., WZETA.ZETA=0x..
ZRC20_TOKENS=""

## Backend-only on-chain (indexer/sync)
ZETA_RPC_URL=
GIVEHUB_CONTRACT_ADDRESS=
GIVEHUB_START_BLOCK=0

## AI (advanced/optional)
# Multiple keys supported (comma-separated). Falls back to GEMINI_API_KEY.
GEMINI_KEYS=
# Optional prompts to customize tone/behavior
GEMINI_SYSTEM_PROMPT=
GEMINI_EDIT_SYSTEM_PROMPT=
GEMINI_PLANNER_PROMPT=
GEMINI_EXECUTOR_PROMPT=
GEMINI_PAY_SYSTEM_PROMPT=

## AI Image Generation (optional)
USE_IMAGEN=false
IMAGEN_MODEL=imagen-4.0-generate-preview-06-06

## Frontend toggles (optional)
# Only used to mirror server toggle in some places; prefer USE_MONGODB above
NEXT_PUBLIC_USE_MONGODB=false
