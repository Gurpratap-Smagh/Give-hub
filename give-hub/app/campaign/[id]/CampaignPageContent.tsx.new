'use client'

import { useEffect, useState, useRef, useCallback, useMemo } from 'react'
import Image from 'next/image'
import { useRouter } from 'next/navigation'
import { useSession } from 'next-auth/react'
import type { Campaign, Donation, Creator } from '@/lib/db'
import { formatCurrency, formatDate } from '@/lib/utils/format'
import { notify } from '@/lib/utils/notify'
import { useAuth } from '@/lib/auth/auth-context'
import { useAvailableTokens } from '@/lib/hooks/useAvailableTokens'
import CampaignEditForm from '@/components/campaign-edit-form'
import PaymentModal from '@/components/payment-modal'
import Spinner from '@/components/spinner'
import Link from 'next/link'
import { ensureWalletOnChain, getCampaignInfo, getCampaignDonations } from '@/lib/web3/client'

// Define types
type CampaignWithCreator = Campaign & { creator?: Creator | null };
type DonationWithAddr = Donation & { address?: string };

export default function CampaignPageContent({ initialCampaign, initialDonations }: { initialCampaign: CampaignWithCreator, initialDonations: Donation[] }) {
  const { user } = useAuth()
  const [campaign, setCampaign] = useState(initialCampaign)
  const [donations, setDonations] = useState<DonationWithAddr[]>(initialDonations as DonationWithAddr[])
  const [isEditing, setIsEditing] = useState(false)
  const [isSaving, setIsSaving] = useState(false)
  const [editPreview, setEditPreview] = useState<CampaignWithCreator>(campaign)
  const [showPaymentModal, setShowPaymentModal] = useState(false)
  const [imageUploading, setImageUploading] = useState(false)
  const [syncingOnChain, setSyncingOnChain] = useState(false)
  
  const isCreator = user?.id === campaign.creatorId

  const handleImageUpload = async (file: File) => {
    if (!file) return
    
    setImageUploading(true)
    try {
      const formData = new FormData()
      formData.append('image', file)
      formData.append('campaignId', campaign.id)
      
      const response = await fetch(`/api/campaigns/${campaign.id}/image`, {
        method: 'POST',
        body: formData,
      })
      
      if (!response.ok) {
        throw new Error('Failed to upload image')
      }
      
      const data = await response.json()
      
      if (data.success) {
        // Update campaign with new image URL
        setCampaign(prev => ({
          ...prev,
          image: data.imageUrl,
        }))
        
        setEditPreview(prev => ({
          ...prev,
          image: data.imageUrl,
        }))
        
        notify('Image uploaded successfully', 'success')
      } else {
        throw new Error(data.message || 'Failed to upload image')
      }
    } catch (error) {
      console.error('Error uploading image:', error)
      notify('Failed to upload image. Please try again.', 'error')
    } finally {
      setImageUploading(false)
    }
  }

  // Calculate total raised amount with better handling of different currencies
  const raisedLocal = useMemo(() => {
    // Group donations by currency/chain for potential future display improvements
    const byCurrency: Record<string, number> = {}
    let total = 0
    
    donations.forEach(donation => {
      const amount = Number(donation.amount) || 0
      const chain = donation.chain || 'unknown'
      
      // Add to currency-specific total
      byCurrency[chain] = (byCurrency[chain] || 0) + amount
      
      // Add to overall total
      total += amount
    })
    
    // For now we return the simple total, but we have the data structure for future enhancements
    return total
  }, [donations])

  const syncCampaignOnChain = async () => {
    // Implementation
    setSyncingOnChain(true)
    // Rest of implementation
    setSyncingOnChain(false)
  }

  const toggleCampaignStatus = async () => {
    // Implementation
  }

  const handlePaymentSuccess = (donation: Donation) => {
    setDonations(prev => [donation as DonationWithAddr, ...prev])
    setShowPaymentModal(false)
  }

  return (
    <div className="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      {/* Creator Panel */}
      {isCreator && (
        <div className="mt-8 p-6 bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700">
          {/* On-chain sync status - only show for synced campaigns */}
          {campaign.onChain && (
            <div className="mb-6">
              <h3 className="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-3">Blockchain Status</h3>
              <div className="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg p-4">
                <div className="flex justify-between items-center">
                  <span className="text-gray-600">Total Raised</span>
                  <span className="font-bold text-gray-900">
                    {formatCurrency(raisedLocal)}
                    {campaign.goal > 0 && (
                      <span className="text-sm text-gray-500 ml-1">({Math.round((raisedLocal / campaign.goal) * 100)}%)</span>
                    )}
                  </span>
                </div>
                <div className="flex items-start">
                  <div className="flex-shrink-0">
                    <svg className="h-5 w-5 text-green-600 dark:text-green-500" fill="currentColor" viewBox="0 0 20 20">
                      <path fillRule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clipRule="evenodd" />
                    </svg>
                  </div>
                  <div className="ml-3">
                    <h3 className="text-sm font-medium text-green-800 dark:text-green-200">Campaign is synced on-chain</h3>
                    <div className="mt-2 text-sm text-green-700 dark:text-green-300">
                      <p>Campaign ID: {campaign.onChain.campaignId}</p>
                      <p className="mt-1">Contract: {campaign.onChain.contractAddress}</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}
          
          {/* For unsynced campaigns, just show the sync button without header */}
          {!campaign.onChain && (
            <div className="mb-6">
              <div className="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-4">
                <div className="flex items-start">
                  <div className="flex-shrink-0">
                    <svg className="h-5 w-5 text-yellow-600 dark:text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                      <path fillRule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clipRule="evenodd" />
                    </svg>
                  </div>
                  <div className="ml-3">
                    <h3 className="text-sm font-medium text-yellow-800 dark:text-yellow-200">Campaign is not synced on-chain</h3>
                    <div className="mt-2 text-sm text-yellow-700 dark:text-yellow-300">
                      <p>This campaign exists only in the database. To enable on-chain donations, sync it to the blockchain.</p>
                    </div>
                    <div className="mt-4">
                      <button
                        type="button"
                        onClick={syncCampaignOnChain}
                        disabled={syncingOnChain}
                        className={`inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white ${syncingOnChain ? 'bg-yellow-400 cursor-not-allowed' : 'bg-yellow-600 hover:bg-yellow-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500'}`}
                      >
                        {syncingOnChain ? (
                          <>
                            <svg className="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                              <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
                              <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            Syncing...
                          </>
                        ) : 'Sync to Blockchain'}
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}
          
          {/* Campaign Management */}
          <div>
            <h3 className="text-lg font-semibold text-gray-800 dark:text-gray-200 mb-3">Campaign Management</h3>
            <div className="flex flex-wrap gap-3">
              <button
                type="button"
                onClick={() => setIsEditing(true)}
                className="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
              >
                <svg className="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1-8a2 2 0 012-2h2a2 2 0 012 2v5m-1 8a2 2 0 01-2 2h-2a2 2 0 01-2-2V9a2 2 0 012-2h2a2 2 0 012 2z" />
                </svg>
                Edit Campaign
              </button>
              <button
                type="button"
                onClick={toggleCampaignStatus}
                className={`inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white ${campaign.status === 'active' ? 'bg-red-600 hover:bg-red-700 focus:ring-red-500' : 'bg-green-600 hover:bg-green-700 focus:ring-green-500'} focus:outline-none focus:ring-2 focus:ring-offset-2`}
              >
                {campaign.status === 'active' ? 'Pause Campaign' : 'Activate Campaign'}
              </button>
            </div>
          </div>
        </div>
      )} 

      {/* Payment Modal */}
      <PaymentModal
        campaign={campaign}
        isOpen={showPaymentModal}
        onClose={() => setShowPaymentModal(false)}
        onPaymentSuccess={handlePaymentSuccess}
      />
    </div>
  )
}
