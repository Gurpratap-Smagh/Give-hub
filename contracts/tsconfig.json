{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "hardhat"]
  },
  "include": [
    "scripts/**/*.ts",
    "test/**/*.ts",
    "./hardhat.config.*"
  ]
}
