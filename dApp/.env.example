# MongoDB Atlas Data API
# Get these from Atlas > Data API. Do NOT expose client-side.
DATA_API_URL=https://data.mongodb-api.com/app/<app-id>/endpoint/data/v1
DATA_API_KEY=replace_me
DATA_API_DATA_SOURCE=Cluster0
DATA_API_DB=givehub

# CORS allowed origins
# Primary production origin, e.g. https://give-hub.vercel.app
APP_ORIGIN=https://your-app.vercel.app
# Optional secondary origin (staging/custom domain)
APP_ORIGIN_ALT=

# Vercel injects VERCEL_URL at runtime (no scheme). We derive https://<VERCEL_URL> in code.
# You don't set this locally.
# VERCEL_URL=

# Rate limit config (defaults: 100 req/min)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
