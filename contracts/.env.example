########################################
# Contracts/.env.example (minimal)
# Fill only what you use. Comments show defaults where applicable.
########################################

# Deployer key (required for live networks)
PRIVATE_KEY=

# Optional fee recipient for legacy Donations script
FEE_RECIPIENT=

# Explorer API keys (optional)
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=

# Gas reporter toggle (set to any non-empty value to enable)
REPORT_GAS=

# RPC URLs (optional; Hardhat has sane defaults)
# Zeta Athens/Mainnet HTTP RPC (used in hardhat.config.js and deploy-crosschain.ts)
ZETA_HTTP=
# Generic RPC for scripts like scripts/set-router.ts
RPC_URL=
# Optional test RPCs if you use those chains
SEPOLIA_RPC_URL=
MUMBAI_RPC_URL=

# ZetaChain core addresses
# For Athens/Mainnet, scripts include built-ins; for Localnet, these are REQUIRED
SYSTEM_CONTRACT_ADDRESS=
# Alias used by scripts/deploy-crosschain.ts
SYSTEM_CONTRACT=
WZETA_ADDRESS=
# Localnet aliases (from `zetachain localnet start` output)
LOCAL_SYSTEM_CONTRACT=
LOCAL_SYSTEM_CONTRACT_ADDRESS=
LOCAL_WZETA=
LOCAL_WZETA_ADDRESS=

# The address of your deployed CrossChainCrowdfund contract
CONTRACT_ADDRESS=

# Uniswap V2 router to enable swaps (owner will set post-deploy if provided)
UNISWAP_ROUTER_ADDRESS=
UNISWAP_ROUTER=

# Optional ZRC-20 addresses for deploy-crosschain constructor args
ETH_ZRC20=
BTC_ZRC20=
USDC_ZRC20=

# Localnet (ZetaChain Anvil)
LOCALNET_RPC_URL=http://127.0.0.1:8545